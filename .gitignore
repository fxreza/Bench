.idea/

# Agent worktrees
.worktrees/

# MobileCLIP model files (~200 MB), fetched by scripts/fetch-clip-model.sh.
# No trailing slash, so an agent worktree's symlink to the main checkout's
# folder is ignored too.
Models.noindex
